<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="cinema" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Les futures classes annotées @Entity seront détectées automatiquement. -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Valeurs locales par défaut, surchargeables par les variables d'environnement. -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:mysql://localhost:3306/cinema?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Europe/Paris"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>

            <!-- Mode sûr par défaut, remplacé ponctuellement pendant l'initialisation. -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Réglages utiles pendant le développement. -->
            <property name="hibernate.show_sql" value="False"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
