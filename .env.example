# Copiez ce fichier vers .env puis remplacez les valeurs d'exemple.
DB_URL=jdbc:mysql://localhost:3306/cinema?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Paris
DB_USER=cinema_user
DB_PASSWORD=change-me

# Valeurs autorisees : validate (usage normal) ou create (reinitialisation).
HIBERNATE_DDL_AUTO=validate
